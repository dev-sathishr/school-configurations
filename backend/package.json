{
  "name": "shaanthied-backend",
  "version": "1.0.0",
  "description": "ShaanthiEd School Management System - Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:clean": "node src/db/clean.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "npm run db:clean && npm run db:migrate && npm run db:seed",
    "db:fresh": "npm run db:reset && npx kill-port 3001 && npm run dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.13.1",
    "ua-parser-js": "^2.0.9",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
